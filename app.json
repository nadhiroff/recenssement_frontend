{
  "expo": {
    "name": "Recensement ZOCLI",
    "slug": "recensement-zocli",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recensementzocli",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "org.zocli.recensement"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F6B4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.zocli.recensement"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Recensement ZOCLI",
      "shortName": "ZOCLI",
      "lang": "fr",
      "themeColor": "#1F6B4F",
      "backgroundColor": "#FAF6EF"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F6B4F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/recenssement_famille-Backend/app"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "918105ef-d126-458f-9031-0c103baa429e"
      }
    },
    "owner": "nadhir_off"
  }
}